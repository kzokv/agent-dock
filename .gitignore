.DS_Store

# Sensitive and machine-local
auth.json
.credentials.json
sqlite/
sessions/
archived_sessions/
log/
tmp/
vendor_imports/
shell_snapshots/

# Runtime state and caches
.worktrees/
history.jsonl
models_cache.json
version.json
.codex-global-state.json
.personality_migration
state_*.sqlite
state_*.sqlite-shm
state_*.sqlite-wal
__pycache__/
*.pyc
*.pyo

# This repository is also used as CODEX_HOME.
# Ignore unrecognized local and runtime state by default.
.codex/*

# Version-controlled Codex policy and source roots.
!.codex/AGENTS.md
!.codex/MANIFEST.md
!.codex/config.base.toml

!.codex/agents/
.codex/agents/config/*.toml

!.codex/prompts/

!.codex/runbooks/

!.codex/scripts/

!.codex/skills/
.codex/skills/.system/

# Session 
session_index.jsonl

# Cache
cache/**
*.sqlite*

# Ephemeral runtime state (team, debate, scope sessions)
.worklog/
.worktree-ports.json

# Claude Code runtime artifacts
.claude/.last-cleanup
.claude/tasks/
.claude/teams/
.claude/backups/
.claude/cache/
.claude/downloads/
.claude/history.jsonl
.claude/ide/
.claude/projects/
.claude/session-env/
.claude/sessions/
.claude/settings.json
.claude/shell-snapshots/
.claude/.credentials.json
.claude/file-history/
.claude/plugins/
.claude/plans/
.claude/paste-cache/
.claude/mcp*.json

# Claude Code tracked files (override ignores above)
!.claude/settings.base.json
!.claude/rules/
!.claude/rules/**
!.claude/agents/
!.claude/agents/**
!.claude/memory/
!.claude/memory/**
