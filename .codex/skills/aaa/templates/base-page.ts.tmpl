// Base page object model — vocabulary layer (locators only, no behavior)

import type { Locator, Page } from "@playwright/test";

export abstract class BasePage<TElements> {
  readonly page: Page;
  private _elements!: TElements;

  constructor(page: Page) {
    this.page = page;
    this.initializeElements();
  }

  get elements(): TElements {
    return this._elements;
  }

  protected set elements(value: TElements) {
    this._elements = value;
  }

  /**
   * Create a locator by data-testid with a human-readable description.
   * The description appears in Playwright traces, HTML reports, and error messages.
   */
  protected locate(testId: string, description: string): Locator {
    return this.page.getByTestId(testId).describe(description);
  }

  /**
   * Create a locator by ARIA role with a human-readable description.
   */
  protected locateByRole(
    role: Parameters<Page["getByRole"]>[0],
    options: Parameters<Page["getByRole"]>[1],
    description: string,
  ): Locator {
    return this.page.getByRole(role, options).describe(description);
  }

  protected abstract initializeElements(): void;
}
