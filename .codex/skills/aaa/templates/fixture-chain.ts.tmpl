// ────────────────────────────────────────────────────────
// Template variables:
//   {{Name}}                — PascalCase name
//   {{camelName}}           — camelCase name
//   {{domain}}              — directory name
//   {{PageOrEndpointClass}} — POM class (web) or Endpoint class (api)
//   {{useMethod}}           — useWebAssistant (web) or useApiAssistant (api)
//   {{instanceImportPath}}  — import path for the POM/endpoint
//   {{assistantImportPath}} — import path for the assistant factory
//   {{apiBaseUrl}}          — API base URL (from config)
//   {{appBaseUrl}}          — App base URL (from config)
//   {{PROJECT_PREFIX}}      — npm scope
