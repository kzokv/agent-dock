#!/usr/bin/env bash
set -euo pipefail

msg_file="${1:-}"
if [[ -z "${msg_file}" || ! -f "${msg_file}" ]]; then
  echo "commit-msg hook error: commit message file not found." >&2
  exit 1
fi

first_line="$(sed -n '1p' "${msg_file}" | tr -d '\r')"

if [[ -z "${first_line}" ]]; then
  echo "Commit message must not be empty." >&2
  exit 1
fi

if [[ "${first_line}" =~ ^(Merge|Revert)\  ]]; then
  exit 0
fi

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)\([a-z0-9._/-]+\): [^[:space:]].+$'
if ! [[ "${first_line}" =~ ${pattern} ]]; then
  cat >&2 <<'EOF'
Invalid commit message format.
Expected: type(scope): subject
Example: feat(onboarding): add config migration check
Allowed types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert
EOF
  exit 1
fi
